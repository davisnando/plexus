{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Dashboard and approval windows",
  "windows": ["main", "approval-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "autostart:default",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "dialog:allow-open"
  ]
}
